<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>no.maddin.oasbuddy</groupId>
    <artifactId>oas-buddy</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>oas-buddy-desktop</artifactId>
  <packaging>jar</packaging>

  <name>OAS Buddy Desktop</name>
  <description>JavaFX desktop application for OAS Buddy.</description>

  <properties>
    <javafx.mainClass>no.maddin.oasbuddy.desktop.Launcher</javafx.mainClass>
    <!-- jpackage's app version rejects a "-SNAPSHOT" suffix, so this is kept separate from project.version -->
    <jpackage.appVersion>0.1.0</jpackage.appVersion>
    <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
    <jpackage.destination>${project.build.directory}/dist</jpackage.destination>
  </properties>

  <dependencies>
    <dependency>
      <groupId>no.maddin.oasbuddy</groupId>
      <artifactId>oas-buddy-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${javafx.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <!-- Assembles target/jpackage-input: the app jar plus every runtime dependency, flat.
             jpackage packages a directory of jars, not a Maven reactor. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
          <executions>
            <execution>
              <id>jpackage-copy-dependencies</id>
              <phase>package</phase>
              <goals>
                <goal>copy-dependencies</goal>
              </goals>
              <configuration>
                <outputDirectory>${jpackage.input}</outputDirectory>
                <includeScope>runtime</includeScope>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
          <executions>
            <execution>
              <id>jpackage-copy-app-jar</id>
              <phase>package</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${jpackage.input}"/>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.panteleyev</groupId>
          <artifactId>jpackage-maven-plugin</artifactId>
          <version>1.8.0</version>
          <configuration>
            <name>OAS Buddy</name>
            <appVersion>${jpackage.appVersion}</appVersion>
            <vendor>OAS Buddy</vendor>
            <description>${project.description}</description>
            <input>${jpackage.input}</input>
            <mainJar>${project.build.finalName}.jar</mainJar>
            <mainClass>${javafx.mainClass}</mainClass>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!-- activates on `mvn -Djpackage package` when running on Linux -->
      <id>jpackage-linux</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <name>Linux</name>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-deb</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <destination>${jpackage.destination}</destination>
                  <type>DEB</type>
                  <linuxPackageName>oas-buddy</linuxPackageName>
                  <linuxAppCategory>Development</linuxAppCategory>
                  <linuxDebMaintainer>mgoldhahn@gmail.com</linuxDebMaintainer>
                  <linuxShortcut>true</linuxShortcut>
                </configuration>
              </execution>
              <execution>
                <id>jpackage-rpm</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>RPM</type>
                  <destination>${jpackage.destination}</destination>
                  <linuxPackageName>oas-buddy</linuxPackageName>
                  <linuxAppCategory>Development</linuxAppCategory>
                  <linuxRpmLicenseType>Apache-2.0</linuxRpmLicenseType>
                  <linuxShortcut>true</linuxShortcut>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- activates on `mvn -Djpackage package` when running on macOS -->
      <id>jpackage-mac</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-pkg</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>PKG</type>
                  <destination>${jpackage.destination}</destination>
                  <macPackageIdentifier>no.maddin.oasbuddy.desktop</macPackageIdentifier>
                  <macPackageName>OAS Buddy</macPackageName>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- activates on `mvn -Djpackage package` when running on Windows -->
      <id>jpackage-windows</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-exe</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>EXE</type>
                  <destination>${jpackage.destination}</destination>
                  <winMenu>true</winMenu>
                  <winShortcut>true</winShortcut>
                  <winDirChooser>true</winDirChooser>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
