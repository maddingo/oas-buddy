<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>no.maddin.oasbuddy</groupId>
    <artifactId>oas-buddy</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>oas-buddy-desktop</artifactId>
  <packaging>jar</packaging>

  <name>OAS Buddy Desktop</name>
  <description>JavaFX desktop application for OAS Buddy.</description>

  <properties>
    <javafx.mainClass>no.maddin.oasbuddy.desktop.Launcher</javafx.mainClass>
    <!-- jpackage's app version rejects a "-SNAPSHOT" suffix, so this is kept separate from project.version -->
    <jpackage.appVersion>0.1.0</jpackage.appVersion>
    <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
    <jpackage.destination>${project.build.directory}/dist</jpackage.destination>
    <!-- jpackage wants a different icon format per OS, so each jpackage-* profile overrides this.
         All three are generated from docs/branding/oas-buddy-icon.svg by tools/generate-icons.sh. -->
    <jpackage.icon>${project.basedir}/src/main/icons/oas-buddy.png</jpackage.icon>
    <jpackage.resourceDir>${project.basedir}/src/main/jpackage/linux</jpackage.resourceDir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>no.maddin.oasbuddy</groupId>
      <artifactId>oas-buddy-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>2.1.0</version>
    </dependency>

    <!-- The slf4j provider, chosen here because choosing one is the application's job: a library
         that picks a provider forces it on every consumer, so oas-buddy-core deliberately ships
         only the API that swagger-parser drags in. This routes slf4j into java.util.logging, where
         the app's own System.getLogger calls already go, so library and application diagnostics
         end up in one place rather than two parallel logging systems. Without it slf4j falls back
         to a no-op logger and discards everything swagger-parser has to say about a document it
         could not parse. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>${testfx.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Filtering is scoped to version.properties alone: the module also ships the branding SVG,
         and running hand-authored or binary assets through the filter is a good way to corrupt
         them. Declaring <resources> replaces the default, hence the unfiltered entry as well. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>no/maddin/oasbuddy/desktop/version.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>no/maddin/oasbuddy/desktop/version.properties</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JavaFX loads its native libraries via System::load, a restricted method: from
               Java 24 that prints a four-line warning, and a future release will block it
               outright unless native access is granted. Surefire puts JavaFX on the classpath,
               so the grant has to name ALL-UNNAMED rather than the module. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!-- So AppInfoTest can check that version.properties really was filtered, instead of
                 only checking that it holds something. -->
            <project.version>${project.version}</project.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${javafx.mainClass}</mainClass>
          <!-- Same native-access grant as above, but this plugin launches JavaFX from the
               module path, where the grant must name javafx.graphics - ALL-UNNAMED would not
               cover it (and a module name the JVM does not know is itself a warning). -->
          <options>
            <option>--enable-native-access=javafx.graphics</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <!-- Assembles target/jpackage-input: the app jar plus every runtime dependency, flat.
             jpackage packages a directory of jars, not a Maven reactor. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
          <executions>
            <execution>
              <id>jpackage-copy-dependencies</id>
              <phase>package</phase>
              <goals>
                <goal>copy-dependencies</goal>
              </goals>
              <configuration>
                <outputDirectory>${jpackage.input}</outputDirectory>
                <includeScope>runtime</includeScope>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
          <executions>
            <execution>
              <id>jpackage-copy-app-jar</id>
              <phase>package</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${jpackage.input}"/>
                  <!-- Rides along into the installed app dir so the Linux packages can install it
                       into the hicolor theme as a genuinely scalable icon (see the postinst in
                       src/main/jpackage/linux). Harmless on the other platforms. -->
                  <copy file="${project.basedir}/src/main/icons/oas-buddy.svg" todir="${jpackage.input}"/>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.panteleyev</groupId>
          <artifactId>jpackage-maven-plugin</artifactId>
          <version>1.8.0</version>
          <configuration>
            <name>OAS Buddy</name>
            <appVersion>${jpackage.appVersion}</appVersion>
            <vendor>OAS Buddy</vendor>
            <description>${project.description}</description>
            <icon>${jpackage.icon}</icon>
            <input>${jpackage.input}</input>
            <mainJar>${project.build.finalName}.jar</mainJar>
            <mainClass>${javafx.mainClass}</mainClass>
            <!-- jpackage puts every jar from the input directory on the classpath, so the
                 installed app is the unnamed-module case: grant native access there too, or the
                 launcher prints the JavaFX System::load warning to whatever stderr an installed
                 app has. -->
            <javaOptions>
              <javaOption>--enable-native-access=ALL-UNNAMED</javaOption>
            </javaOptions>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <!-- activates on `mvn -Djpackage package` when running on Linux -->
      <id>jpackage-linux</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <name>Linux</name>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <!-- Supplies our "OAS Buddy.desktop", which points Icon= at the bundled SVG so the
                   Linux packages get a scalable icon. Applies to DEB, RPM and APP_IMAGE alike. -->
              <resourceDir>${jpackage.resourceDir}</resourceDir>
            </configuration>
            <executions>
              <execution>
                <id>jpackage-deb</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <destination>${jpackage.destination}</destination>
                  <type>DEB</type>
                  <linuxPackageName>oas-buddy</linuxPackageName>
                  <linuxAppCategory>Development</linuxAppCategory>
                  <linuxDebMaintainer>mgoldhahn@gmail.com</linuxDebMaintainer>
                  <linuxShortcut>true</linuxShortcut>
                </configuration>
              </execution>
              <execution>
                <id>jpackage-rpm</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>RPM</type>
                  <destination>${jpackage.destination}</destination>
                  <linuxPackageName>oas-buddy</linuxPackageName>
                  <linuxAppCategory>Development</linuxAppCategory>
                  <linuxRpmLicenseType>Apache-2.0</linuxRpmLicenseType>
                  <linuxShortcut>true</linuxShortcut>
                </configuration>
              </execution>
              <execution>
                <!-- Portable app-image (no OS installer), tarred up in CI for direct download/
                     manual install, and as the fetch target for a future AUR -bin package. -->
                <id>jpackage-app-image</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>APP_IMAGE</type>
                  <destination>${jpackage.destination}</destination>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- activates on `mvn -Djpackage package` when running on macOS -->
      <id>jpackage-mac</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/icons/oas-buddy.icns</jpackage.icon>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-pkg</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>PKG</type>
                  <destination>${jpackage.destination}</destination>
                  <macPackageIdentifier>no.maddin.oasbuddy.desktop</macPackageIdentifier>
                  <macPackageName>OAS Buddy</macPackageName>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- activates on `mvn -Djpackage package` when running on Windows -->
      <id>jpackage-windows</id>
      <activation>
        <property>
          <name>jpackage</name>
        </property>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/icons/oas-buddy.ico</jpackage.icon>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-exe</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <type>EXE</type>
                  <destination>${jpackage.destination}</destination>
                  <winMenu>true</winMenu>
                  <winShortcut>true</winShortcut>
                  <winDirChooser>true</winDirChooser>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
